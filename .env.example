# Copie para .env e preencha. NUNCA faça commit do .env.
# Sem chave, o CardFactory funciona apenas com o provedor simulado.
OPENROUTER_API_KEY=
# Diretório de dados local (banco, documentos, exportações)
CARDFACTORY_DATA_DIR=./data
# Porta local (bind sempre em 127.0.0.1)
CARDFACTORY_PORT=8765
# Alternativa à chave local: um proxy de saída injeta o cabeçalho Authorization (ex.: segredo de rede do
# ambiente em nuvem). Com 1, o app não exige nem envia a chave.
OPENROUTER_AUTH_VIA_PROXY=
